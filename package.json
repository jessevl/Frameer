{
  "name": "@frameer/ui",
  "version": "0.4.3",
  "description": "Frameer - A reusable React UI framework with Tailwind CSS theming",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./components/ui": {
      "import": "./dist/components/ui/index.js",
      "types": "./dist/components/ui/index.d.ts"
    },
    "./components/ui/date": {
      "import": "./dist/components/ui/date/index.js",
      "types": "./dist/components/ui/date/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./stores": {
      "import": "./dist/stores/index.js",
      "types": "./dist/stores/index.d.ts"
    },
    "./lib": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    },
    "./contexts": {
      "import": "./dist/contexts/index.js",
      "types": "./dist/contexts/index.d.ts"
    },
    "./icons": {
      "import": "./dist/icons/index.js",
      "types": "./dist/icons/index.d.ts"
    },
    "./clay": {
      "import": "./dist/clay/index.js",
      "types": "./dist/clay/index.d.ts"
    },
    "./build": {
      "import": "./dist/build/index.js",
      "types": "./dist/build/index.d.ts"
    },
    "./shell": {
      "import": "./dist/shell/index.js",
      "types": "./dist/shell/index.d.ts"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/empty.css": "./src/styles/empty.css",
    "./styles/motion.css": "./src/styles/motion.css",
    "./styles/density.css": "./src/styles/density.css",
    "./styles/hues.css": "./src/styles/hues.css",
    "./styles/paper.css": "./src/styles/paper.css",
    "./styles/grain/*": "./src/styles/grain/*",
    "./styles/shell.css": "./src/styles/shell.css",
    "./styles/phone.css": "./src/styles/phone.css",
    "./styles/print.css": "./src/styles/print.css",
    "./styles/reading.css": "./src/styles/reading.css",
    "./styles/signin.css": "./src/styles/signin.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tanstack/react-router": "^1.0.0"
  },
  "dependencies": {
    "zustand": "^5.0.0",
    "lucide-react": "^0.555.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^24",
    "typescript": "^5.7.0",
    "tsup": "^8.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.0"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "design-system",
    "frameer"
  ],
  "author": "Jesse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jessevl/Frameer.git"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    }
  }
}
